.DS_Store

# Swift / Xcode
.build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# Python toolchain
tools/.venv/
__pycache__/

# In-project caches (HF_HOME / Xet scratch). Pinned inside the project by
# tools/project_env.py so weights download here instead of ~/.cache.
.cache/

# Converted CoreML bundles (4.8 GB total, regenerated by tools/convert.py and
# tools/download_whisperkit_models.py). Local-first per Atlas convention:
# never committed, but the inventory + re-acquire commands live in the
# committed placeholder below. See Models/MANIFEST.md.
#
# Note: `Models/*` not `Models/` on purpose. Git never descends into an
# excluded directory, so a later `!Models/MANIFEST.md` would be silently
# ignored if the directory itself were excluded.
Models/*
*.mlpackage/

# ...except the placeholder and the size/path index, which must be committed
# so a fresh clone knows what to fetch and how to verify it.
!Models/MANIFEST.md
!Models/.gitkeep
